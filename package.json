{
  "name": "njiwa-medusa",
  "version": "0.1.0",
  "description": "WhatsApp your customers when their Medusa order is paid, fulfilled or cancelled, and get a message yourself when one comes in.",
  "author": "UPEO.AI (https://upeo.ai)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Upeosoft-Limited/njiwa-medusa.git"
  },
  "license": "MIT",
  "files": [
    ".medusa/server"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./admin": {
      "import": "./.medusa/server/src/admin/index.mjs",
      "require": "./.medusa/server/src/admin/index.js",
      "default": "./.medusa/server/src/admin/index.js"
    },
    "./.medusa/server/src/modules/*": "./.medusa/server/src/modules/*/index.js",
    "./modules/*": "./.medusa/server/src/modules/*/index.js",
    "./*": "./.medusa/server/src/*.js"
  },
  "keywords": [
    "medusa",
    "plugin",
    "medusa-plugin",
    "medusa-plugin-other",
    "medusa-plugin-notification",
    "medusa-v2",
    "whatsapp",
    "njiwa"
  ],
  "scripts": {
    "build": "medusa plugin:build",
    "dev": "medusa plugin:develop",
    "test": "jest",
    "prepublishOnly": "medusa plugin:build",
    "prepare": "medusa plugin:build"
  },
  "devDependencies": {
    "@medusajs/admin-sdk": "2.20.1",
    "@medusajs/cli": "2.20.1",
    "@medusajs/framework": "2.20.1",
    "@medusajs/types": "2.20.1",
    "@medusajs/ui": "4.x",
    "@swc/core": "^1.7.28",
    "@swc/jest": "^0.2.36",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.3.0",
    "jest": "^29.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.0"
  },
  "peerDependencies": {
    "@medusajs/framework": "^2.20.0",
    "@medusajs/medusa": "^2.20.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
